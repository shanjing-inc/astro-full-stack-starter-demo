{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "astro-full-stack-cloudflare-d1-demo",
    "main": "./src/worker.ts",
    "compatibility_date": "2026-05-19",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true,
        },
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["PublicWebSocketRoom"],
        },
        {
            "tag": "v2",
            "new_sqlite_classes": ["CacheObject"],
        },
    ],
    "env": {
        "dev": {
            "name": "astro-full-stack-cloudflare-d1-demo",
            "assets": {
                "directory": "./dist",
                "binding": "ASSETS",
            },
            "durable_objects": {
                "bindings": [
                    {
                        "name": "WEBSOCKET_ROOM",
                        "class_name": "PublicWebSocketRoom",
                    },
                    {
                        "name": "CACHE_OBJECT",
                        "class_name": "CacheObject",
                    },
                ],
            },
            "vars": {
                "BETTER_AUTH_ALLOWED_HOSTS": "localhost:*,127.0.0.1:*",
                "LOG_SQL": "false",
                "QUEUE_EXECUTION_RECORD_TTL_SECONDS": "604800",
                "SENTRY_DSN": "",
                "SENTRY_RELEASE": "dev",
                "WEBSOCKET_ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321",
                "WEBSOCKET_IDLE_TIMEOUT_SECONDS": "120",
                "WEBSOCKET_MAX_CONNECTIONS": "100",
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "astro-full-stack-cloudflare-d1-demo",
                    "database_id": "00000000-0000-0000-0000-000000000000",
                    "migrations_dir": "drizzle",
                },
            ],
            "kv_namespaces": [
                {
                    "binding": "CACHE_KV",
                    "id": "00000000000000000000000000000000",
                    "preview_id": "00000000000000000000000000000000",
                },
            ],
            "triggers": {
                "crons": ["30 4 * * *"],
            },
            "queues": {
                "producers": [
                    {
                        "binding": "QUEUE_CRITICAL",
                        "queue": "astro-full-stack-cloudflare-d1-demo-critical",
                    },
                    {
                        "binding": "QUEUE_DEFAULT",
                        "queue": "astro-full-stack-cloudflare-d1-demo-default",
                    },
                    {
                        "binding": "QUEUE_LOW",
                        "queue": "astro-full-stack-cloudflare-d1-demo-low",
                    },
                ],
                "consumers": [
                    {
                        "queue": "astro-full-stack-cloudflare-d1-demo-critical",
                        "max_batch_size": 5,
                        "max_batch_timeout": 5,
                        "max_retries": 3,
                    },
                    {
                        "queue": "astro-full-stack-cloudflare-d1-demo-default",
                        "max_batch_size": 5,
                        "max_batch_timeout": 5,
                        "max_retries": 3,
                    },
                    {
                        "queue": "astro-full-stack-cloudflare-d1-demo-low",
                        "max_batch_size": 5,
                        "max_batch_timeout": 5,
                        "max_retries": 3,
                        "max_concurrency": 1,
                    },
                ],
            },
        },
        "production": {
            "name": "astro-full-stack-cloudflare-d1-demo-production",
            // Set BETTER_AUTH_SECRET through `wrangler secret put --env production`.
            "assets": {
                "directory": "./dist",
                "binding": "ASSETS",
            },
            "durable_objects": {
                "bindings": [
                    {
                        "name": "WEBSOCKET_ROOM",
                        "class_name": "PublicWebSocketRoom",
                    },
                    {
                        "name": "CACHE_OBJECT",
                        "class_name": "CacheObject",
                    },
                ],
            },
            "vars": {
                "BETTER_AUTH_ALLOWED_HOSTS": "*.workers.dev",
                "LOG_SQL": "false",
                "QUEUE_EXECUTION_RECORD_TTL_SECONDS": "604800",
                "SENTRY_DSN": "",
                "SENTRY_RELEASE": "production",
                "WEBSOCKET_ALLOWED_ORIGINS": "https://*.workers.dev",
                "WEBSOCKET_IDLE_TIMEOUT_SECONDS": "120",
                "WEBSOCKET_MAX_CONNECTIONS": "100",
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "astro-full-stack-cloudflare-d1-demo-production",
                    "database_id": "42618eda-8feb-4857-b0d9-cc67f924593e",
                    "migrations_dir": "drizzle",
                },
            ],
            "kv_namespaces": [
                {
                    "binding": "SESSION",
                    "id": "c439b7304666401c8c8510ea71985cbd",
                    "preview_id": "1a402de362494d029600bd3021922ca1",
                },
                {
                    "binding": "CACHE_KV",
                    "id": "dc2e57f57ca14595bce4aba34eb766ad",
                    "preview_id": "a4382145f5ad4e9f8405823d99b5303b",
                },
            ],
            "triggers": {
                "crons": ["30 4 * * *"],
            },
            "queues": {
                "producers": [
                    {
                        "binding": "QUEUE_CRITICAL",
                        "queue": "astro-full-stack-cloudflare-d1-demo-production-critical",
                    },
                    {
                        "binding": "QUEUE_DEFAULT",
                        "queue": "astro-full-stack-cloudflare-d1-demo-production-default",
                    },
                    {
                        "binding": "QUEUE_LOW",
                        "queue": "astro-full-stack-cloudflare-d1-demo-production-low",
                    },
                ],
                "consumers": [
                    {
                        "queue": "astro-full-stack-cloudflare-d1-demo-production-critical",
                        "max_batch_size": 5,
                        "max_batch_timeout": 5,
                        "max_retries": 3,
                    },
                    {
                        "queue": "astro-full-stack-cloudflare-d1-demo-production-default",
                        "max_batch_size": 5,
                        "max_batch_timeout": 5,
                        "max_retries": 3,
                    },
                    {
                        "queue": "astro-full-stack-cloudflare-d1-demo-production-low",
                        "max_batch_size": 5,
                        "max_batch_timeout": 5,
                        "max_retries": 3,
                        "max_concurrency": 1,
                    },
                ],
            },
        },
    },
}
