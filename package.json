{
    "name": "cloudflare-d1-demo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.15.1",
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=11.15.1"
    },
    "scripts": {
        "preinstall": "node ./scripts/enforce-package-manager.mjs",
        "prepare": "node ./scripts/prepare-husky.mjs",
        "check:pre-commit": "lint-staged --config ./package.json",
        "codegen": "node ./scripts/export-graphql-schema.mjs && graphql-codegen --config codegen.yml && prettier --write \"src/graphql/generated/**/*.{ts,graphql}\"",
        "dev": "XDG_CONFIG_HOME=.wrangler/config CLOUDFLARE_ENV=dev astro dev",
        "start": "XDG_CONFIG_HOME=.wrangler/config CLOUDFLARE_ENV=dev astro dev",
        "build": "XDG_CONFIG_HOME=.wrangler/config astro build",
        "build:cf": "pnpm build && node ./scripts/prepare-cloudflare-env-config.mjs",
        "check": "pnpm lint:check && pnpm format:check && pnpm test && pnpm codegen && astro-check",
        "cf:types": "XDG_CONFIG_HOME=.wrangler/config wrangler types ./src/worker-configuration.d.ts --env dev",
        "deploy:dry-run": "pnpm deploy:dry-run:production",
        "deploy:dry-run:production": "XDG_CONFIG_HOME=.wrangler/config wrangler deploy --dry-run --config dist/server/wrangler.production.json",
        "deploy:production": "pnpm build:cf && XDG_CONFIG_HOME=.wrangler/config wrangler deploy --config dist/server/wrangler.production.json",
        "sentry:sourcemaps": "node ./scripts/upload-sentry-sourcemaps.mjs",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "XDG_CONFIG_HOME=.wrangler/config wrangler d1 migrations apply DB --env dev --local",
        "db:migrate:remote": "pnpm db:migrate:remote:production",
        "db:migrate:remote:production": "XDG_CONFIG_HOME=.wrangler/config wrangler d1 migrations apply DB --env production --remote",
        "cf:secret:production": "XDG_CONFIG_HOME=.wrangler/config wrangler secret put BETTER_AUTH_SECRET --env production",
        "lint:check": "eslint . --cache --cache-location node_modules/.cache/eslint-cache/.eslintcache",
        "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint-cache/.eslintcache --fix",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "sync": "astro sync",
        "test": "vitest run --config tests/config/vitest.unit.config.ts --configLoader runner && vitest run --config tests/config/vitest.integration.config.ts --configLoader runner",
        "test:unit": "vitest run --config tests/config/vitest.unit.config.ts --configLoader runner",
        "test:integration": "vitest run --config tests/config/vitest.integration.config.ts --configLoader runner",
        "test:e2e": "playwright test --config tests/config/playwright.e2e.config.ts"
    },
    "lint-staged": {
        "*": "node scripts/check-staged-files.mjs"
    },
    "dependencies": {
        "@apollo/client": "^4.2.7",
        "@fontsource-variable/inter": "^5.3.0",
        "@nanostores/persistent": "^1.3.5",
        "@nanostores/react": "^1.1.0",
        "@pothos/core": "^4.13.1",
        "@pothos/plugin-drizzle": "^0.17.5",
        "@sentry/astro": "^10.67.0",
        "@sentry/cloudflare": "^10.67.0",
        "@shanjing/astro-full-stack-starter": "1.0.3",
        "better-auth": "^1.6.24",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "1.0.0-rc.4",
        "graphql": "^17.0.2",
        "graphql-yoga": "^5.21.2",
        "lucide-react": "^1.25.0",
        "nanostores": "^1.4.1",
        "radix-ui": "^1.6.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.0",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/cloudflare": "^14.1.4",
        "@astrojs/react": "^6.0.1",
        "@eslint/js": "^10.0.1",
        "@graphql-codegen/cli": "^7.2.0",
        "@graphql-codegen/typescript": "^6.1.0",
        "@graphql-codegen/typescript-operations": "^6.1.1",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/better-sqlite3": "^7.6.13",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitest/coverage-v8": "^4.1.10",
        "astro": "^7.1.3",
        "better-sqlite3": "^13.0.1",
        "drizzle-kit": "1.0.0-rc.4",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.0.1",
        "eslint-plugin-better-tailwindcss": "^4.7.0",
        "eslint-plugin-check-file": "^3.3.2",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jsonc-parser": "^3.3.1",
        "lint-staged": "^17.1.1",
        "picomatch": "4.0.5",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10",
        "wrangler": "^4.113.0"
    }
}
