{
    "name": "deno-mysql-demo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.5.0",
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=11.5.0"
    },
    "scripts": {
        "preinstall": "node ./scripts/enforce-package-manager.mjs",
        "codegen": "node ./scripts/export-graphql-schema.mjs && graphql-codegen --config codegen.yml",
        "queue:sync": "node ./scripts/generate-queue-manifest.mjs",
        "dev": "pnpm queue:sync && astro dev",
        "start": "pnpm queue:sync && astro dev",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "build": "pnpm build:release",
        "build:release": "node ./scripts/ensure-workspace-starter-build.mjs && pnpm queue:sync && node ./scripts/check-package-manager-artifacts.mjs && node ./scripts/check-deno-compat.mjs && astro build && node ./scripts/prepare-deno-deploy.mjs --profile=release",
        "build:debug": "node ./scripts/ensure-workspace-starter-build.mjs && pnpm queue:sync && node ./scripts/check-package-manager-artifacts.mjs && node ./scripts/check-deno-compat.mjs && astro build && node ./scripts/prepare-deno-deploy.mjs --profile=debug",
        "sentry:sourcemaps": "node ./scripts/upload-sentry-sourcemaps.mjs",
        "check": "pnpm node ./scripts/check-package-manager-artifacts.mjs && node ./scripts/check-deno-compat.mjs && pnpm lint:check && pnpm format:check && pnpm test && pnpm codegen && astro-check",
        "sync": "astro sync",
        "lint:check": "eslint . --cache --cache-location node_modules/.cache/eslint-cache/.eslintcache",
        "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint-cache/.eslintcache --fix",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "test": "pnpm queue:sync && vitest run --configLoader runner",
        "test:coverage": "node ./scripts/run-vitest-coverage.mjs",
        "test:e2e": "playwright test",
        "test:watch": "vitest --configLoader runner",
        "queue:worker": "pnpm queue:sync && node --env-file-if-exists=.env --env-file-if-exists=../../.env ./scripts/start-queue-worker.mjs",
        "queue:worker:dist": "deno run --no-npm --node-modules-dir=none --allow-net --allow-read --allow-env --env-file=.env ./dist/deno/queues/worker.mjs",
        "queue:scheduler": "pnpm queue:sync && node --env-file-if-exists=.env --env-file-if-exists=../../.env ./scripts/start-queue-scheduler.mjs",
        "queue:scheduler:dist": "deno run --no-npm --node-modules-dir=none --allow-net --allow-read --allow-env --env-file=.env ./dist/deno/queues/scheduler.mjs",
        "preview": "deno serve --no-npm --node-modules-dir=none --allow-net --allow-read --allow-env --env-file=.env ./dist/deno/server/serve.mjs",
        "preview:parallel": "deno serve --parallel --no-npm --node-modules-dir=none --allow-net --allow-read --allow-env --env-file=.env ./dist/deno/server/serve.mjs"
    },
    "dependencies": {
        "@apollo/client": "^4.1.9",
        "@fontsource-variable/inter": "^5.2.8",
        "@nanostores/persistent": "^1.3.3",
        "@nanostores/react": "^1.1.0",
        "@pothos/core": "^4.12.0",
        "@pothos/plugin-drizzle": "^0.17.1",
        "@sentry/astro": "^10.51.0",
        "@sentry/deno": "^10.51.0",
        "@shanjing/astro-full-stack-starter": "0.9.0",
        "better-auth": "^1.6.9",
        "bullmq": "^5.73.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "beta",
        "drizzle-zod": "^0.8.3",
        "graphql": "^16.13.2",
        "graphql-yoga": "^5.21.0",
        "ioredis": "^5.10.1",
        "lucide-react": "^1.8.0",
        "mysql2": "^3.22.0",
        "nanostores": "^1.2.0",
        "radix-ui": "^1.4.3",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-router": "^7.15.1",
        "shadcn": "^4.4.0",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/react": "^5.0.5",
        "@deno/astro-adapter": "0.5.1",
        "@eslint/js": "^9.39.4",
        "@graphql-codegen/cli": "^6.3.0",
        "@graphql-codegen/typescript": "^5.0.10",
        "@graphql-codegen/typescript-operations": "^5.1.0",
        "@playwright/test": "^1.59.1",
        "@tailwindcss/vite": "^4.2.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.58.2",
        "@typescript-eslint/parser": "^8.58.2",
        "@vitest/coverage-v8": "^4.1.4",
        "astro": "^6.3.5",
        "better-sqlite3": "^12.0.0",
        "drizzle-kit": "1.0.0-beta.21",
        "esbuild": "0.28.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-better-tailwindcss": "^4.4.1",
        "eslint-plugin-check-file": "^3.3.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^17.5.0",
        "husky": "^9.1.7",
        "jsdom": "^29.0.2",
        "prettier": "^3.8.3",
        "prettier-plugin-astro": "^0.14.1",
        "source-map-js": "^1.2.1",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.58.2",
        "vitest": "^4.1.4"
    }
}
