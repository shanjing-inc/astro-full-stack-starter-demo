{
    "name": "cloudflare-d1-demo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.5.0",
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=11.5.0"
    },
    "scripts": {
        "preinstall": "node ./scripts/enforce-package-manager.mjs",
        "codegen": "node ./scripts/export-graphql-schema.mjs && graphql-codegen --config codegen.yml && prettier --write \"src/graphql/generated/**/*.{ts,graphql}\"",
        "dev": "XDG_CONFIG_HOME=.wrangler/config CLOUDFLARE_ENV=dev astro dev",
        "start": "XDG_CONFIG_HOME=.wrangler/config CLOUDFLARE_ENV=dev astro dev",
        "build": "astro build",
        "build:cf": "astro build && node ./scripts/prepare-cloudflare-env-config.mjs",
        "check": "pnpm lint:check && pnpm format:check && pnpm test && pnpm codegen && astro-check",
        "cf:types": "XDG_CONFIG_HOME=.wrangler/config wrangler types ./src/worker-configuration.d.ts --env dev",
        "deploy:dry-run": "pnpm deploy:dry-run:production",
        "deploy:dry-run:production": "XDG_CONFIG_HOME=.wrangler/config wrangler deploy --dry-run --config dist/server/wrangler.production.json",
        "deploy:production": "pnpm build:cf && XDG_CONFIG_HOME=.wrangler/config wrangler deploy --config dist/server/wrangler.production.json",
        "sentry:sourcemaps": "node ./scripts/upload-sentry-sourcemaps.mjs",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "XDG_CONFIG_HOME=.wrangler/config wrangler d1 migrations apply DB --env dev --local",
        "db:migrate:remote": "pnpm db:migrate:remote:production",
        "db:migrate:remote:production": "XDG_CONFIG_HOME=.wrangler/config wrangler d1 migrations apply DB --env production --remote",
        "cf:secret:production": "XDG_CONFIG_HOME=.wrangler/config wrangler secret put BETTER_AUTH_SECRET --env production",
        "lint:check": "eslint . --cache --cache-location node_modules/.cache/eslint-cache/.eslintcache",
        "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint-cache/.eslintcache --fix",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "sync": "astro sync",
        "test": "vitest run --configLoader runner",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@apollo/client": "^4.1.9",
        "@fontsource-variable/inter": "^5.2.8",
        "@nanostores/persistent": "^1.3.3",
        "@nanostores/react": "^1.1.0",
        "@pothos/core": "^4.12.0",
        "@pothos/plugin-drizzle": "^0.17.1",
        "@sentry/astro": "^10.51.0",
        "@sentry/cloudflare": "^10.51.0",
        "@shanjing/astro-full-stack-starter": "master",
        "better-auth": "^1.6.9",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "beta",
        "graphql": "^16.13.2",
        "graphql-yoga": "^5.21.0",
        "lucide-react": "^1.8.0",
        "nanostores": "^1.2.0",
        "radix-ui": "^1.4.3",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-router": "^7.15.1",
        "tailwind-merge": "^3.5.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/cloudflare": "^13.5.2",
        "@astrojs/react": "^5.0.5",
        "@graphql-codegen/cli": "^6.3.0",
        "@graphql-codegen/typescript": "^5.0.10",
        "@graphql-codegen/typescript-operations": "^5.1.0",
        "@playwright/test": "^1.59.1",
        "@tailwindcss/vite": "^4.2.2",
        "@types/better-sqlite3": "^7.6.13",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitest/coverage-v8": "^4.1.4",
        "@eslint/js": "^9.39.4",
        "@typescript-eslint/eslint-plugin": "^8.58.2",
        "@typescript-eslint/parser": "^8.58.2",
        "astro": "^6.3.5",
        "better-sqlite3": "^12.0.0",
        "drizzle-kit": "1.0.0-beta.21",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.5.0",
        "prettier": "^3.8.3",
        "prettier-plugin-astro": "^0.14.1",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.58.2",
        "vitest": "^4.1.4",
        "jsonc-parser": "^3.3.1",
        "wrangler": "^4.93.0"
    }
}
