{
    "name": "deno-mysql-demo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.15.1",
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=11.15.1"
    },
    "scripts": {
        "preinstall": "node ./scripts/enforce-package-manager.mjs",
        "prepare": "node ./scripts/prepare-husky.mjs",
        "check:pre-commit": "lint-staged --config ./package.json",
        "codegen": "node ./scripts/export-graphql-schema.mjs && graphql-codegen --config codegen.yml",
        "queue:sync": "node ./scripts/generate-queue-manifest.mjs",
        "dev": "pnpm queue:sync && astro dev",
        "start": "pnpm queue:sync && astro dev",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migration:bundle": "node ./scripts/create-migration-bundle.mjs",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "build": "pnpm build:release",
        "build:release": "node ./scripts/ensure-workspace-starter-build.mjs && pnpm queue:sync && node ./scripts/check-package-manager-artifacts.mjs && node ./scripts/check-deno-compat.mjs && astro build && node ./scripts/prepare-deno-deploy.mjs --profile=release",
        "build:debug": "node ./scripts/ensure-workspace-starter-build.mjs && pnpm queue:sync && node ./scripts/check-package-manager-artifacts.mjs && node ./scripts/check-deno-compat.mjs && astro build && node ./scripts/prepare-deno-deploy.mjs --profile=debug",
        "sentry:sourcemaps": "node ./scripts/upload-sentry-sourcemaps.mjs",
        "check": "pnpm node ./scripts/check-package-manager-artifacts.mjs && node ./scripts/check-deno-compat.mjs && pnpm lint:check && pnpm format:check && pnpm test && pnpm codegen && astro-check",
        "sync": "astro sync",
        "lint:check": "eslint . --cache --cache-location node_modules/.cache/eslint-cache/.eslintcache",
        "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint-cache/.eslintcache --fix",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "test": "pnpm queue:sync && vitest run --config tests/config/vitest.unit.config.ts --configLoader runner && vitest run --config tests/config/vitest.integration.config.ts --configLoader runner",
        "test:unit": "pnpm queue:sync && vitest run --config tests/config/vitest.unit.config.ts --configLoader runner",
        "test:integration": "pnpm queue:sync && vitest run --config tests/config/vitest.integration.config.ts --configLoader runner",
        "test:coverage": "pnpm queue:sync && node ./scripts/run-vitest-coverage.mjs",
        "test:e2e": "playwright test --config tests/config/playwright.e2e.config.ts",
        "test:watch": "pnpm queue:sync && vitest --config tests/config/vitest.coverage.config.ts --configLoader runner",
        "queue:worker": "pnpm queue:sync && node --env-file-if-exists=.env --env-file-if-exists=../../.env ./scripts/start-queue-worker.mjs",
        "queue:worker:dist": "deno run --no-npm --node-modules-dir=none --allow-net --allow-read --allow-env --env-file=.env ./dist/deno/queues/worker.mjs",
        "queue:scheduler": "pnpm queue:sync && node --env-file-if-exists=.env --env-file-if-exists=../../.env ./scripts/start-queue-scheduler.mjs",
        "queue:scheduler:dist": "deno run --no-npm --node-modules-dir=none --allow-net --allow-read --allow-env --env-file=.env ./dist/deno/queues/scheduler.mjs",
        "preview": "deno serve --no-npm --node-modules-dir=none --allow-net --allow-read --allow-env --env-file=.env ./dist/deno/server/serve.mjs",
        "preview:parallel": "deno serve --parallel --no-npm --node-modules-dir=none --allow-net --allow-read --allow-env --env-file=.env ./dist/deno/server/serve.mjs"
    },
    "lint-staged": {
        "*": "node scripts/check-staged-files.mjs"
    },
    "dependencies": {
        "@apollo/client": "^4.2.7",
        "@fontsource-variable/inter": "^5.3.0",
        "@nanostores/persistent": "^1.3.5",
        "@nanostores/react": "^1.1.0",
        "@pothos/core": "^4.13.1",
        "@pothos/plugin-drizzle": "^0.17.5",
        "@sentry/astro": "^10.67.0",
        "@sentry/deno": "^10.67.0",
        "@shanjing/astro-full-stack-starter": "1.0.1",
        "better-auth": "^1.6.24",
        "bullmq": "^5.80.10",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "1.0.0-rc.4",
        "drizzle-zod": "^0.8.3",
        "graphql": "^17.0.2",
        "graphql-yoga": "^5.21.2",
        "ioredis": "^5.11.1",
        "lucide-react": "^1.25.0",
        "mysql2": "^3.23.1",
        "nanostores": "^1.4.1",
        "radix-ui": "^1.6.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.0",
        "shadcn": "^4.14.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/react": "^6.0.1",
        "@deno/astro-adapter": "0.6.0",
        "@eslint/js": "^10.0.1",
        "@graphql-codegen/cli": "^7.2.0",
        "@graphql-codegen/typescript": "^6.1.0",
        "@graphql-codegen/typescript-operations": "^6.1.1",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript/native": "npm:typescript@7.0.2",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitest/coverage-v8": "^4.1.10",
        "astro": "^7.1.3",
        "better-sqlite3": "^13.0.1",
        "drizzle-kit": "1.0.0-rc.4",
        "esbuild": "0.28.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.0.1",
        "eslint-plugin-better-tailwindcss": "^4.7.0",
        "eslint-plugin-check-file": "^3.3.2",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.1.1",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "source-map-js": "^1.2.1",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    }
}
