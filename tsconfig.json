{
    "extends": "astro/tsconfigs/strict",
    "include": [
        ".astro/types.d.ts",
        "astro.config.mjs",
        "drizzle.config.ts",
        "src/**/*",
        "tests/**/*"
    ],
    "exclude": ["dist", "node_modules"],
    "compilerOptions": {
        "baseUrl": ".",
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "types": ["node"],
        "paths": {
            "@/*": ["src/*"]
        }
    }
}
