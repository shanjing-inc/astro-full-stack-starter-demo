---
import { and, eq, inArray } from "drizzle-orm";

import { LoginForm } from "@/components/admin/login-form";
import { databaseProvider } from "@/db/client";
import BaseLayout from "@/layouts/base-layout.astro";
import { auth } from "@/lib/auth";
import { resolveDashboardReturnTo } from "@/lib/dashboard-return-to";
import { appendAuthCookies } from "@shanjing/astro-full-stack-starter/dashboard/auth";

const dashboardPath = "/replace-with-your-admin-path";
const loginPath = `${dashboardPath}/login`;
const db = databaseProvider.getDb();
const user = databaseProvider.schema.user;

let defaultEmail = "";
let errorMessage = "";
let returnTo = resolveDashboardReturnTo(Astro.url.searchParams.get("returnTo"), dashboardPath);

const adminUsers = await db
    .select({ id: user.id })
    .from(user)
    .where(inArray(user.role, ["owner", "admin"]))
    .limit(1);
const hasAdmin = adminUsers.length > 0;

if (!hasAdmin) {
    return new Response(null, {
        status: 303,
        headers: {
            location: "/replace-with-your-admin-path/install",
        },
    });
}

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const email = String(formData.get("email") ?? "").trim();
    const password = String(formData.get("password") ?? "");

    defaultEmail = email;
    returnTo = resolveDashboardReturnTo(String(formData.get("returnTo") ?? ""), dashboardPath);

    if (!email || !password) {
        errorMessage = "请输入邮箱和密码。";
    } else {
        try {
            const adminAccountRows = await db
                .select({ id: user.id })
                .from(user)
                .where(and(eq(user.email, email), inArray(user.role, ["owner", "admin"])))
                .limit(1);
            const adminAccount = adminAccountRows[0];

            if (!adminAccount) {
                errorMessage = "请输入已初始化的管理员邮箱。";
            } else {
                const authResponse = await auth.api.signInEmail({
                    body: {
                        email,
                        password,
                    },
                    headers: Astro.request.headers,
                    asResponse: true,
                });

                if (!authResponse.ok) {
                    errorMessage = "邮箱或密码无效。";
                } else {
                    const headers = new Headers();

                    appendAuthCookies(authResponse.headers, headers);
                    headers.set("location", returnTo);

                    return new Response(null, {
                        status: 303,
                        headers,
                    });
                }
            }
        } catch {
            errorMessage = "邮箱或密码无效。";
        }
    }
}
---

<BaseLayout title="Admin Login">
    <section class="flex min-h-[calc(100vh-5rem)] items-center justify-center">
        <LoginForm
            action={loginPath}
            className="w-full max-w-5xl"
            defaultEmail={defaultEmail}
            errorMessage={errorMessage}
            returnTo={returnTo}
        />
    </section>
</BaseLayout>
