---
import { and, eq, inArray } from "drizzle-orm";

import { LoginForm } from "@/components/admin/login-form";
import { createCloudflareD1DatabaseProvider, getCloudflareD1Env } from "@/db/client";
import BaseLayout from "@/layouts/base-layout.astro";
import { auth } from "@/lib/auth";
import { appendAuthCookies } from "@shanjing/astro-full-stack-starter/dashboard/auth";
import { user } from "@shanjing/astro-full-stack-starter/db/d1/schemas";

const provider = createCloudflareD1DatabaseProvider(getCloudflareD1Env());
const db = provider.getDb();
let defaultEmail = "";
let errorMessage = "";
const adminRows = await db
    .select({ id: user.id })
    .from(user)
    .where(inArray(user.role, ["owner", "admin"]))
    .limit(1);

if (adminRows.length === 0) {
    return new Response(null, {
        status: 303,
        headers: {
            location: "/replace-with-your-admin-path/install",
        },
    });
}

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const email = String(formData.get("email") ?? "")
        .trim()
        .toLowerCase();
    const password = String(formData.get("password") ?? "");

    defaultEmail = email;

    if (!email || !password) {
        errorMessage = "请输入邮箱和密码。";
    } else {
        const rows = await db
            .select({ id: user.id })
            .from(user)
            .where(and(eq(user.email, email), inArray(user.role, ["owner", "admin"])))
            .limit(1);

        if (rows.length === 0) {
            errorMessage = "请输入已初始化的管理员邮箱。";
        } else {
            try {
                const authResponse = await auth.api.signInEmail({
                    body: {
                        email,
                        password,
                    },
                    headers: Astro.request.headers,
                    asResponse: true,
                });

                if (!authResponse.ok) {
                    errorMessage = "邮箱或密码无效。";
                } else {
                    const headers = new Headers();

                    appendAuthCookies(authResponse.headers, headers);
                    headers.set("location", "/replace-with-your-admin-path");

                    return new Response(null, {
                        status: 303,
                        headers,
                    });
                }
            } catch {
                errorMessage = "邮箱或密码无效。";
            }
        }
    }
}
---

<BaseLayout title="Admin Login">
    <section class="flex min-h-[calc(100vh-5rem)] items-center justify-center">
        <LoginForm
            className="w-full max-w-5xl"
            defaultEmail={defaultEmail}
            errorMessage={errorMessage}
        />
    </section>
</BaseLayout>
