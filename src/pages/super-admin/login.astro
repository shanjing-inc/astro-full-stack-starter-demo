---
import { and, eq } from "drizzle-orm";

import { LoginForm } from "@/components/super-admin/login-form";
import { databaseProvider } from "@/db/client";
import BaseLayout from "@/layouts/base-layout.astro";
import { auth } from "@/lib/auth";
import { appendAuthCookies } from "@shanjing/astro-full-stack-starter/super-admin";

const db = databaseProvider.getDb();
const user = databaseProvider.schema.user;

let defaultEmail = "";
let errorMessage = "";

const adminUsers = await db
    .select({ id: user.id })
    .from(user)
    .where(eq(user.role, "admin"))
    .limit(1);
const hasAdmin = adminUsers.length > 0;

if (!hasAdmin) {
    return new Response(null, {
        status: 303,
        headers: {
            location: "/super-admin/install",
        },
    });
}

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const email = String(formData.get("email") ?? "").trim();
    const password = String(formData.get("password") ?? "");

    defaultEmail = email;

    if (!email || !password) {
        errorMessage = "请输入邮箱和密码。";
    } else {
        try {
            const adminAccountRows = await db
                .select({ id: user.id })
                .from(user)
                .where(and(eq(user.email, email), eq(user.role, "admin")))
                .limit(1);
            const adminAccount = adminAccountRows[0];

            if (!adminAccount) {
                errorMessage = "Super admin account is required.";
            } else {
                const authResponse = await auth.api.signInEmail({
                    body: {
                        email,
                        password,
                    },
                    headers: Astro.request.headers,
                    asResponse: true,
                });

                if (!authResponse.ok) {
                    errorMessage = "邮箱或密码无效。";
                } else {
                    const headers = new Headers();

                    appendAuthCookies(authResponse.headers, headers);
                    headers.set("location", "/super-admin");

                    return new Response(null, {
                        status: 303,
                        headers,
                    });
                }
            }
        } catch {
            errorMessage = "邮箱或密码无效。";
        }
    }
}
---

<BaseLayout title="Super Admin Login">
    <section class="flex min-h-[calc(100vh-5rem)] items-center justify-center">
        <LoginForm
            className="w-full max-w-5xl"
            defaultEmail={defaultEmail}
            errorMessage={errorMessage}
        />
    </section>
</BaseLayout>
