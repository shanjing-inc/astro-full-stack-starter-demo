---
import CounterIsland from "@/components/public/counter-island";
import BaseLayout from "@/layouts/base-layout.astro";

const featureCards = [
    {
        description: "加载预设 query / mutation，直接请求 /api/graphql 并查看返回结果。",
        href: "/test/graphql",
        label: "GraphQL 测试页",
        tag: "graphql",
    },
    {
        description: "验证 mysql2 连接、Drizzle 初始化，以及数据库测试表是否可读。",
        href: "/test/database",
        label: "Database 测试页",
        tag: "database",
    },
    {
        description: "手动派发 BullMQ default / critical 队列任务，观察 worker 消费日志。",
        href: "/test/queue",
        label: "Queue 测试页",
        tag: "queue",
    },
    {
        description: "通过 Redis cache adapter 验证 TTL 缓存和 lock capability。",
        href: "/test/cache",
        label: "Cache 测试页",
        tag: "cache",
    },
    {
        description: "连接 /api/websocket/public，测试 WebSocket ping、echo 和自定义 JSON 消息。",
        href: "/test/websocket",
        label: "WebSocket 测试页",
        tag: "websocket",
    },
    {
        description: "连接 /api/sse/public，测试 EventSource ready 事件和服务端主动推送。",
        href: "/test/sse",
        label: "SSE 测试页",
        tag: "sse",
    },
    {
        description: "会员中心示例，验证 member dashboard、会员权限和 member GraphQL 端点。",
        href: "/member",
        label: "Member",
        tag: "member",
    },
    {
        description: "管理商品、店铺、订单和队列运行状态，验证后台 SPA、权限和 GraphQL 管理端点。",
        href: "/replace-with-your-admin-path",
        label: "Admin",
        tag: "admin",
    },
];
---

<BaseLayout title="Astro Deno Starter">
    <section class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <div class="space-y-6">
            <p class="text-sm font-medium tracking-[0.3em] text-muted-foreground uppercase">
                Deno Runtime Ready
            </p>
            <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-foreground sm:text-6xl">
                Astro 7 + React Dashboard + GraphQL + Deno SSR 示例
            </h1>
            <p class="max-w-2xl text-base/8 text-muted-foreground sm:text-lg">
                当前首页集中展示运行能力测试与后台应用入口。测试页用于验证
                MySQL、BullMQ、GraphQL、Cache、WebSocket 与 SSE；Member 和 Admin 用于验证两套
                dashboard、权限与数据端点。
            </p>
            <div class="flex flex-wrap gap-3 text-sm text-muted-foreground">
                <span class="rounded-full border bg-secondary px-4 py-2 text-secondary-foreground">
                    astro
                </span>
                <span class="rounded-full border bg-secondary px-4 py-2 text-secondary-foreground">
                    deno
                </span>
                <span class="rounded-full border bg-secondary px-4 py-2 text-secondary-foreground">
                    react
                </span>
                <span class="rounded-full border bg-secondary px-4 py-2 text-secondary-foreground">
                    tailwindcss
                </span>
                <span class="rounded-full border bg-secondary px-4 py-2 text-secondary-foreground">
                    drizzle
                </span>
                <span class="rounded-full border bg-secondary px-4 py-2 text-secondary-foreground">
                    mysql2
                </span>
                <span class="rounded-full border bg-secondary px-4 py-2 text-secondary-foreground">
                    bullmq
                </span>
                <span class="rounded-full border bg-secondary px-4 py-2 text-secondary-foreground">
                    cache
                </span>
                <span class="rounded-full border bg-secondary px-4 py-2 text-secondary-foreground">
                    websocket
                </span>
                <span class="rounded-full border bg-secondary px-4 py-2 text-secondary-foreground">
                    sse
                </span>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
                {
                    featureCards.map((card) => (
                        <a
                            class="group rounded-xl border bg-card p-6 text-card-foreground shadow-sm transition hover:bg-accent hover:text-accent-foreground"
                            href={card.href}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <p class="text-xs font-medium tracking-[0.3em] text-muted-foreground uppercase">
                                {card.tag}
                            </p>
                            <h2 class="mt-4 text-2xl font-semibold">{card.label}</h2>
                            <p class="mt-3 leading-7 text-muted-foreground">{card.description}</p>
                            <p class="mt-6 text-sm text-primary transition">进入测试页 →</p>
                        </a>
                    ))
                }
            </div>
        </div>
        <CounterIsland client:load />
    </section>
</BaseLayout>
