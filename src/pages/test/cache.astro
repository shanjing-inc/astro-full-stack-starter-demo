---
import {
    createRedisCacheStore,
    createRedisNamespace,
    getRedisKeyPrefix,
    getRedisUrl,
} from "@shanjing/astro-full-stack-starter/cache/adapters/redis";
import BaseLayout from "@/layouts/base-layout.astro";

const runId = sanitizeRunId(Astro.request.headers.get("x-loadtest-run-id") ?? "manual");
const action = Astro.url.searchParams.get("lock");
const logicalProbeKey = `loadtest:${runId}:cache-probe`;
const redisProbeKey = createRedisNamespace("cache").key(logicalProbeKey);
const lockKey = `loadtest:${runId}:cache-lock-demo`;
const redisLockKey = createRedisNamespace("lock").key(lockKey);
const probeValue = {
    ok: true,
    runId,
    storedAt: new Date().toISOString(),
};

let errorMessage: string | null = null;
let storedValue: typeof probeValue | null = null;
let redisUrlConfigured = false;
let lockStatus = "idle";
let lockReleaseMode = "-";

interface LockResult {
    acquired: boolean;
    mode: string;
    releasedAutomatically: boolean;
}

try {
    const cache = createRedisCacheStore({
        name: "redis-demo-cache",
    });
    redisUrlConfigured = Boolean(getRedisUrl());

    await cache.set(logicalProbeKey, probeValue, {
        ttlSeconds: 60,
    });
    storedValue = await cache.get<typeof probeValue>(logicalProbeKey);

    if (action === "acquire") {
        const lock = await cache.lock?.acquire(lockKey, {
            ttlSeconds: 60,
        });
        lockStatus = lock ? "acquired" : "busy";
        lockReleaseMode = lock ? "ttl" : "-";
    } else if (action === "withLock") {
        const result = await cache.lock?.withLock<LockResult>(
            lockKey,
            async () => ({
                acquired: true,
                mode: "withLock",
                releasedAutomatically: true,
            }),
            {
                ttlSeconds: 60,
            }
        );
        lockStatus = result ? "acquired" : "busy";
        lockReleaseMode = result?.releasedAutomatically ? "auto" : "-";
    }
} catch (error) {
    errorMessage = error instanceof Error ? error.message : "Cache 探针失败。";
}

function sanitizeRunId(value: string) {
    return value.replace(/[^a-zA-Z0-9:_-]/g, "-").slice(0, 80) || "manual";
}
---

<BaseLayout title="Cache Test">
    <section class="space-y-8">
        <div class="space-y-4">
            <a
                class="inline-flex text-sm font-medium text-primary transition hover:text-primary/80"
                href="/"
            >
                ← 返回首页
            </a>
            <p class="text-sm font-medium tracking-[0.3em] text-muted-foreground uppercase">
                Cache Test
            </p>
            <h1 class="text-4xl font-semibold tracking-tight text-foreground">Redis Cache 测试</h1>
            <p class="max-w-3xl leading-8 text-muted-foreground">
                这个页面通过标准 cache contract 访问 Redis adapter，写入短 TTL 探针数据，并展示 lock
                capability。
            </p>
        </div>

        <section class="grid gap-4 lg:grid-cols-3">
            <div class="rounded-xl border bg-card p-6 text-card-foreground shadow-sm">
                <p class="text-sm font-medium tracking-[0.3em] text-primary uppercase">adapter</p>
                <h2 class="mt-4 text-2xl font-semibold">redis</h2>
                <dl class="mt-5 grid gap-3 text-sm text-muted-foreground">
                    <div>
                        <dt class="font-medium text-foreground">consistency</dt>
                        <dd class="font-mono">strong-per-key</dd>
                    </div>
                    <div>
                        <dt class="font-medium text-foreground">lock_supported</dt>
                        <dd>true</dd>
                    </div>
                </dl>
            </div>
            <div class="rounded-xl border bg-card p-6 text-card-foreground shadow-sm">
                <p class="text-sm font-medium tracking-[0.3em] text-primary uppercase">probe</p>
                <h2 class="mt-4 text-2xl font-semibold">TTL 写入读取</h2>
                <p class="mt-3 text-sm/7 text-muted-foreground">
                    当前探针使用 60 秒 TTL，value 通过 JSON serialization 往返。
                </p>
            </div>
            <div class="rounded-xl border bg-card p-6 text-card-foreground shadow-sm">
                <p class="text-sm font-medium tracking-[0.3em] text-primary uppercase">lock</p>
                <h2 class="mt-4 text-2xl font-semibold">60 秒锁任务</h2>
                <p class="mt-3 text-sm/7 text-muted-foreground">
                    acquire 模式通过 TTL 保留锁，withLock 模式在 callback 完成后自动释放。
                </p>
            </div>
        </section>

        <section class="rounded-xl border bg-card p-6 text-card-foreground shadow-sm">
            {
                errorMessage ? (
                    <div class="space-y-3">
                        <p class="text-sm font-medium tracking-[0.3em] text-destructive uppercase">
                            error
                        </p>
                        <pre class="overflow-auto rounded-lg bg-destructive/10 p-4 text-sm text-destructive">
                            {errorMessage}
                        </pre>
                    </div>
                ) : (
                    <div class="space-y-4">
                        <p class="text-sm font-medium tracking-[0.3em] text-primary uppercase">
                            ok
                        </p>
                        <dl class="grid gap-3 text-sm text-muted-foreground md:grid-cols-[160px_1fr]">
                            <dt class="font-medium text-foreground">adapter</dt>
                            <dd>redis-demo-cache</dd>
                            <dt class="font-medium text-foreground">key</dt>
                            <dd class="font-mono break-all">{redisProbeKey}</dd>
                            <dt class="font-medium text-foreground">value</dt>
                            <dd class="font-mono break-all">
                                {storedValue ? JSON.stringify(storedValue) : "-"}
                            </dd>
                            <dt class="font-medium text-foreground">prefix</dt>
                            <dd class="font-mono break-all">{getRedisKeyPrefix() || "-"}</dd>
                            <dt class="font-medium text-foreground">url_configured</dt>
                            <dd>{redisUrlConfigured ? "yes" : "no"}</dd>
                        </dl>
                    </div>
                )
            }
        </section>

        <section class="rounded-xl border bg-card p-6 text-card-foreground shadow-sm">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                <div>
                    <p class="text-sm font-medium tracking-[0.3em] text-primary uppercase">
                        lock demo
                    </p>
                    <h2 class="mt-3 text-2xl font-semibold">模拟 60 秒锁定任务</h2>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a
                        class="rounded-lg border bg-background px-4 py-2 text-sm font-medium text-foreground transition hover:bg-accent hover:text-accent-foreground"
                        href="/test/cache?lock=acquire"
                    >
                        acquire
                    </a>
                    <a
                        class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition hover:bg-primary/90"
                        href="/test/cache?lock=withLock"
                    >
                        withLock
                    </a>
                </div>
            </div>
            <dl class="mt-6 grid gap-3 text-sm text-muted-foreground md:grid-cols-[160px_1fr]">
                <dt class="font-medium text-foreground">lock_key</dt>
                <dd class="font-mono break-all">{redisLockKey}</dd>
                <dt class="font-medium text-foreground">lock_status</dt>
                <dd>{lockStatus}</dd>
                <dt class="font-medium text-foreground">release_mode</dt>
                <dd>{lockReleaseMode}</dd>
            </dl>
        </section>
    </section>
</BaseLayout>
