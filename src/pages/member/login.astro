---
import { and, eq } from "drizzle-orm";

import { LoginForm } from "@/components/admin/login-form";
import { databaseProvider } from "@/db/client";
import BaseLayout from "@/layouts/base-layout.astro";
import { auth } from "@/lib/auth";
import { appendAuthCookies } from "@shanjing/astro-full-stack-starter/dashboard/auth";

const db = databaseProvider.getDb();
const user = databaseProvider.schema.user;

let defaultEmail = "";
let errorMessage = "";

const currentSession = await auth.api.getSession({
    headers: Astro.request.headers,
});

if (
    Astro.request.method === "GET" &&
    currentSession?.session &&
    (currentSession.user?.role === "member" ||
        currentSession.user?.role === "admin" ||
        currentSession.user?.role === "owner")
) {
    return new Response(null, {
        status: 303,
        headers: {
            location: "/member",
        },
    });
}

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const email = String(formData.get("email") ?? "").trim();
    const password = String(formData.get("password") ?? "");

    defaultEmail = email;

    if (!email || !password) {
        errorMessage = "请输入邮箱和密码。";
    } else {
        try {
            const memberAccountRows = await db
                .select({ id: user.id })
                .from(user)
                .where(and(eq(user.email, email), eq(user.role, "member")))
                .limit(1);
            const memberAccount = memberAccountRows[0];

            if (!memberAccount) {
                errorMessage = "Member account is required.";
            } else {
                const authResponse = await auth.api.signInEmail({
                    body: {
                        email,
                        password,
                    },
                    headers: Astro.request.headers,
                    asResponse: true,
                });

                if (!authResponse.ok) {
                    errorMessage = "邮箱或密码无效。";
                } else {
                    const headers = new Headers();

                    appendAuthCookies(authResponse.headers, headers);
                    headers.set("location", "/member");

                    return new Response(null, {
                        status: 303,
                        headers,
                    });
                }
            }
        } catch {
            errorMessage = "邮箱或密码无效。";
        }
    }
}
---

<BaseLayout title="Member Login">
    <section class="flex min-h-[calc(100vh-5rem)] items-center justify-center">
        <LoginForm
            action="/member/login"
            className="w-full max-w-5xl"
            defaultEmail={defaultEmail}
            description="使用会员账号登录"
            errorMessage={errorMessage}
            title="Member"
        />
    </section>
</BaseLayout>
