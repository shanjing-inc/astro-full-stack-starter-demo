# Database
# DATABASE_URL query parameters:
# - drizzleMode: default or planetscale.
DATABASE_URL=mysql://root:your_password@127.0.0.1:3306/test_astro_with_deno?drizzleMode=default
LOG_SQL=false

# Timezone legacy override
# New projects use the default UTC storage timezone.
# Set TZ=Asia/Shanghai when legacy MySQL DATETIME literals are East Asia local time.

# Redis
REDIS_URL=redis://:your_password@127.0.0.1:6379/0
REDIS_KEY_PREFIX=

# Queue
QUEUE_EXECUTION_RECORD_TTL_SECONDS=604800
QUEUE_JOB_RETENTION_SECONDS=604800
QUEUE_JOB_RETENTION_COUNT=50

# Application and auth
APP_ORIGIN=http://localhost:4321
BETTER_AUTH_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters

# WebSocket
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:8000,http://127.0.0.1:8000
WEBSOCKET_IDLE_TIMEOUT_SECONDS=60
WEBSOCKET_MAX_CONNECTIONS=100

# Observability
SENTRY_DSN=

# Deno memory (FEATURE-272)
# DENO_SERVE_PARALLEL defaults to 0 in start-web.sh (lower RSS)
# DENO_SERVE_PARALLEL=0

# Idle memory reclaim (default off)
DENO_IDLE_MEMORY_RECLAIM_ENABLED=0
DENO_IDLE_MEMORY_RECLAIM_LOG_LEVEL=warn
DENO_IDLE_MEMORY_RECLAIM_AFTER_MS=600000
DENO_IDLE_MEMORY_RECLAIM_CHECK_INTERVAL_MS=30000
DENO_IDLE_MEMORY_RECLAIM_MIN_RSS_ANON_MB=80
DENO_IDLE_MEMORY_RECLAIM_IGNORED_PATHS=/api/internal/runtime-memory,/api/internal/health

# Optional jemalloc preload (BASE_IMAGE installs libjemalloc2; preload is opt-in only)
# LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2
# MALLOC_CONF=background_thread:true,dirty_decay_ms:5000,narenas:2
